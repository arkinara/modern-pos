[Unit]
Description=Modern POS verified off-host PostgreSQL backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pos-ops
Group=pos-ops
WorkingDirectory=/opt/modern-pos/current
EnvironmentFile=/etc/modern-pos/backup.env
ExecStart=/usr/bin/node ops/backup.mjs
TimeoutStartSec=20min
UMask=0077
StateDirectory=modern-pos-ops
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

