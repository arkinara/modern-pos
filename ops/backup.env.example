DATABASE_URL=postgresql://pos_backup:REPLACE_IN_SECRET_STORE@db.example.invalid/modern_pos?sslmode=verify-full
BACKUP_SSH_TARGET=pos-backup@backup.example.invalid
BACKUP_REMOTE_DIR=/srv/backups/modern-pos
BACKUP_RETENTION_DAYS=14
BACKUP_SPOOL_DIR=/var/lib/modern-pos-ops
BACKUP_SUCCESS_FILE=/var/lib/modern-pos-ops/verified-backup.json
BACKUP_SSH_KEY=/etc/modern-pos/backup_ed25519
BACKUP_KNOWN_HOSTS=/etc/modern-pos/backup_known_hosts
