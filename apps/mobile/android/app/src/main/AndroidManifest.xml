<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Receipt printer transport: Bluetooth Classic (RFCOMM/SPP) candidate.
         Ticket #15 does NOT claim this transport is verified; see
         docs/printer-validation.md. The permission split below follows Android
         platform documentation. On-device behaviour is PENDING — requires an
         Android test device. -->

    <!-- Android 11 and below: install-time Bluetooth permissions used to find
         and connect a paired receipt printer. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>

    <!-- Android 6-11: fine location is required by the platform to discover
         Bluetooth devices. This app does not derive location from it. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30"/>

    <!-- Android 12+ (API 31+): runtime permissions for connecting to and
         scanning for a paired receipt printer. neverForLocation keeps discovery
         out of location use. Both are requestable again after denial. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>

    <!-- Printing must remain optional so the cashier app installs on devices
         without Bluetooth hardware; the UI reports the missing capability. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false"/>

    <!-- USB host is optional as well. Ticket #25 adds a USB bulk-transfer
         transport but physical delivery is PENDING until a real printer and
         Android device are tested. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false"/>

    <application
        android:label="Modern POS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
