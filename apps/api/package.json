{
  "name": "@modern-pos/api",
  "version": "0.1.0",
  "private": true,
  "description": "Modern POS NestJS API (scaffold).",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/health/*.test.ts src/auth/*.test.ts src/common/guards/*.test.ts src/settings/*.test.ts src/outlets/*.test.ts src/catalog/*.test.ts src/stock/*.test.ts src/recipe/*.test.ts src/sales/*.test.ts src/promotions/*.test.ts src/reports/*.test.ts src/printing/*.test.ts src/payments/*.test.ts",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "format:check": "prettier --check ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/passport": "12.0.1",
    "@nestjs/platform-express": "12.4.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/passport-jwt": "4.0.1",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
