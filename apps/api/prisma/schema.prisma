// Identity, authorization, business settings, catalog and stock schema.
// Recipes, sales, reports and printing domain models land in #8-#10.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  CASHIER
}

enum SessionPlatform {
  WEB
  MOBILE
}

enum StockPolicy {
  TRACKED
  UNTRACKED
}

enum StockBaseUnit {
  g
  ml
  each
}

enum StockMovementType {
  OPENING
  RECEIPT
  ADJUSTMENT
  SALE
  REVERSAL
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets    Outlet[]
  users      User[]
  categories Category[]
  menuItems  MenuItem[]
  stockItems StockItem[]

  @@map("businesses")
}

model Outlet {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @db.Uuid
  name             String
  timezone         String   @default("Asia/Jakarta")
  currency         String   @default("IDR")
  currencyExponent Int      @default(0)
  receiptAddress   String   @default("")
  receiptHeader    String   @default("")
  receiptFooter    String   @default("")
  taxBps           Int      @default(0)
  serviceBps       Int      @default(0)
  pricingMode      String   @default("EXCLUSIVE")
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       User[]
  outletMenus OutletMenu[]
  balances    StockBalance[]
  movements   StockMovement[]

  @@unique([businessId, name])
  @@map("outlets")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  outletId     String?  @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @default("")
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet    Outlet?         @relation(fields: [outletId], references: [id], onDelete: SetNull)
  sessions  Session[]
  movements StockMovement[]

  @@map("users")
}

// Opaque refresh tokens are stored only as SHA-256 hashes. Rotation replaces a
// session row with a new row in the same family; replaying a used token revokes
// the whole family.
model Session {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  familyId     String          @db.Uuid
  tokenHash    String          @unique
  csrfHash     String?
  platform     SessionPlatform
  deviceId     String?         @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?         @db.Uuid
  createdAt    DateTime        @default(now())
  lastUsedAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@unique([id, businessId])
  @@index([businessId, archivedAt])
  @@map("categories")
}

model MenuItem {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  categoryId  String    @db.Uuid
  name        String
  description String    @default("")
  revision    Int       @default(1)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId, businessId], references: [id, businessId])
  variants MenuVariant[]

  @@index([businessId, archivedAt])
  @@index([categoryId])
  @@map("menu_items")
}

model MenuVariant {
  id          String      @id @default(uuid()) @db.Uuid
  menuItemId  String      @db.Uuid
  name        String
  priceMinor  BigInt
  active      Boolean     @default(true)
  stockPolicy StockPolicy @default(UNTRACKED)
  revision    Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  menuItem    MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  outletMenus OutletMenu[]

  @@index([menuItemId])
  @@map("menu_variants")
}

model OutletMenu {
  outletId  String   @db.Uuid
  variantId String   @db.Uuid
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet  Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  variant MenuVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([outletId, variantId])
  @@index([variantId])
  @@map("outlet_menu")
}

// Stock quantities are fixed-point decimals(20,6). The base unit is immutable
// after the first movement because every historical delta is expressed in it.
model StockItem {
  id               String        @id @default(uuid()) @db.Uuid
  businessId       String        @db.Uuid
  name             String
  baseUnit         StockBaseUnit
  quantityScale    Int
  reorderThreshold Decimal       @db.Decimal(20, 6)
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  balances  StockBalance[]
  movements StockMovement[]

  @@unique([id, businessId])
  @@index([businessId, archivedAt])
  @@map("stock_items")
}

model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  outletId    String   @db.Uuid
  stockItemId String   @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(20, 6)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet    Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([outletId, stockItemId])
  @@index([stockItemId])
  @@map("stock_balances")
}

// Append-only ledger. The migration adds a trigger that rejects UPDATE and
// DELETE so a balance is always derivable from SUM(delta) per outlet+item.
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  outletId     String            @db.Uuid
  stockItemId  String            @db.Uuid
  delta        Decimal           @db.Decimal(20, 6)
  type         StockMovementType
  actorId      String            @db.Uuid
  reason       String
  sourceId     String            @db.Uuid
  sourceLineId String?           @db.Uuid
  createdAt    DateTime          @default(now())

  outlet    Outlet    @relation(fields: [outletId], references: [id], onDelete: Restrict)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  actor     User      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([outletId, stockItemId, createdAt])
  @@index([stockItemId])
  @@map("stock_movements")
}

// Durable idempotency mapping for stock writes. The unique (outletId, key)
// pair reserves the key inside the same transaction as the movement.
model StockIdempotency {
  id           String   @id @default(uuid()) @db.Uuid
  outletId     String   @db.Uuid
  key          String   @db.Uuid
  operation    String
  requestHash  String
  movementId   String?  @db.Uuid
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([outletId, key])
  @@index([createdAt])
  @@map("stock_idempotency")
}
