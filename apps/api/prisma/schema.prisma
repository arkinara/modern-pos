// Identity, authorization, business settings, catalog, stock, recipes, sales,
// reports and printing metadata schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  CASHIER
}

enum SessionPlatform {
  WEB
  MOBILE
}

enum StockPolicy {
  TRACKED
  UNTRACKED
}

enum StockBaseUnit {
  g
  ml
  each
}

enum StockMovementType {
  OPENING
  RECEIPT
  ADJUSTMENT
  COUNT
  WASTE
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_CANCEL
  SALE
  REVERSAL
  CHANNEL_ORDER_ACCEPT
  CHANNEL_ORDER_CANCEL
}

enum PurchaseOrderState {
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum WasteReason {
  DAMAGE
  EXPIRY
  THEFT
  SPOILAGE
  OTHER
}

enum TransferState {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum OrderState {
  DRAFT
  COMPLETED
  CANCELLED
  SPLIT
}

enum OrderAuditAction {
  OPEN
  UPDATE
  TRANSFER
  SPLIT
  CANCEL
  FINALIZE
  PROMOTION
  APPROVAL
  REFUND
}

enum SaleState {
  COMPLETED
  REVERSED
}

enum SaleReversalKind {
  FULL
  PARTIAL
}

enum PromotionKind {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionStacking {
  EXCLUSIVE
  STACKABLE
}

enum ApprovalAction {
  DISCOUNT
  REFUND
  CASH_OUT
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum ShiftCashMovementKind {
  PAID_IN
  PAID_OUT
}

enum OperationAuditAction {
  SHIFT_OPENED
  SHIFT_CLOSED
  CASH_PAID_IN
  CASH_PAID_OUT
  ATTENDANCE_CLOCK_IN
  ATTENDANCE_CLOCK_OUT
}

enum PaymentKind {
  CASH
  MANUAL_EXTERNAL
  ONLINE
}

enum PaymentStatus {
  RECORDED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  MOCK
  QRIS
}

enum PrinterTransport {
  BLUETOOTH
  LAN
  USB
}

enum PrintJobState {
  QUEUED
  SENDING
  SENT
  FAILED
  UNKNOWN
}

enum CostingMethod {
  MOVING_AVERAGE
  LAST_PURCHASE
}

enum StationKind {
  KITCHEN
  BAR
  COLD
  HOT
  OTHER
}

enum StationJobKind {
  ORIGINAL
  AMEND
  CANCEL
}

enum OrderChannel {
  MANUAL
  PHONE
  WEB
  GRABFOOD
  SHOPEEFOOD
}

enum ChannelOrderState {
  RECEIVED
  ACCEPTED
  FULFILLED
  CANCELLED
}

enum ChannelPaymentMode {
  CASH_ON_PICKUP
  PREPAID_PROVIDER
}

enum ChannelPaymentStatus {
  UNPAID
  PAID
}

enum CustomerConsentSource {
  WEB_CHECKOUT
  STAFF_ENTRY
  IMPORT
}

enum CustomerContactType {
  EMAIL
  PHONE
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets          Outlet[]
  users            User[]
  categories       Category[]
  menuItems        MenuItem[]
  stockItems       StockItem[]
  recipeVersions   RecipeVersion[]
  orders           Order[]
  quotes           Quote[]
  sales            Sale[]
  saleReversals    SaleReversal[]
  checkoutRequests CheckoutRequest[]
  printers         Printer[]
  printJobs        PrintJob[]
  stations         Station[]
  stationRoutes    StationRoute[]
  stationJobs      StationJob[]
  diningTables     DiningTable[]
  orderAudits      OrderAudit[]
  orderSplits      OrderSplit[]
  promotions       Promotion[]
  approvalRules    ApprovalRule[]
  itemModifiers    MenuItemModifier[]
  onlinePayments   OnlinePayment[]
  shifts           Shift[]
  shiftMovements   ShiftCashMovement[]
  attendance       AttendanceRecord[]
  operationAudits  OperationAudit[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  stockCounts      StockCount[]
  stockWastes      StockWaste[]
  outletTransfers  OutletTransfer[]
  bookkeepingSettings BookkeepingSetting[]
  expenseCategories ExpenseCategory[]
  expenses         Expense[]
  customers        Customer[]
  customerPolicies CustomerRetentionPolicy[]
  channelOrders    ChannelOrder[]
  digitalReceipts  DigitalReceipt[]

  @@map("businesses")
}

model Outlet {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @db.Uuid
  name             String
  timezone         String   @default("Asia/Jakarta")
  currency         String   @default("IDR")
  currencyExponent Int      @default(0)
  receiptAddress   String   @default("")
  receiptHeader    String   @default("")
  receiptFooter    String   @default("")
  taxBps           Int      @default(0)
  serviceBps       Int      @default(0)
  pricingMode      String   @default("EXCLUSIVE")
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users            User[]
  outletMenus      OutletMenu[]
  balances         StockBalance[]
  movements        StockMovement[]
  recipeVersions   RecipeVersion[]
  orders           Order[]
  quotes           Quote[]
  sales            Sale[]
  saleReversals    SaleReversal[]
  checkoutRequests CheckoutRequest[]
  printers         Printer[]
  printJobs        PrintJob[]
  stations         Station[]
  stationRoutes    StationRoute[]
  stationJobs      StationJob[]
  diningTables     DiningTable[]
  orderAudits      OrderAudit[]
  orderSplits      OrderSplit[]
  promotions       Promotion[]
  approvalRules    ApprovalRule[]
  itemModifiers    MenuItemModifier[]
  onlinePayments   OnlinePayment[]
  shifts           Shift[]
  shiftMovements   ShiftCashMovement[]
  attendance       AttendanceRecord[]
  operationAudits  OperationAudit[]
  purchaseOrders   PurchaseOrder[]
  stockCounts      StockCount[]
  stockWastes      StockWaste[]
  transfersFrom    OutletTransfer[]    @relation("TransferSourceOutlet")
  transfersTo      OutletTransfer[]    @relation("TransferDestinationOutlet")
  bookkeepingSetting BookkeepingSetting?
  expenses         Expense[]
  customers        Customer[]
  customerPolicy   CustomerRetentionPolicy?
  channelOrders    ChannelOrder[]
  digitalReceipts  DigitalReceipt[]

  @@unique([businessId, name])
  @@map("outlets")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  outletId     String?  @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @default("")
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet                Outlet?             @relation(fields: [outletId], references: [id], onDelete: SetNull)
  sessions              Session[]
  movements             StockMovement[]
  orders                Order[]             @relation("OrderCashier")
  sales                 Sale[]              @relation("SaleCashier")
  reversals             SaleReversal[]      @relation("SaleReversalActor")
  orderAudits           OrderAudit[]        @relation("OrderAuditActor")
  orderSplits           OrderSplit[]        @relation("OrderSplitActor")
  shiftsOpened          Shift[]             @relation("ShiftOpenedBy")
  shiftsClosed          Shift[]             @relation("ShiftClosedBy")
  shiftCashMovements    ShiftCashMovement[]
  attendanceRecords     AttendanceRecord[]
  operationAudits       OperationAudit[]
  purchaseOrdersCreated PurchaseOrder[]     @relation("PurchaseOrderCreatedBy")
  stockCountsCreated    StockCount[]        @relation("StockCountActor")
  stockWastesCreated    StockWaste[]        @relation("StockWasteActor")
  transfersCreated      OutletTransfer[]    @relation("TransferCreatedBy")
  transfersDispatched   OutletTransfer[]    @relation("TransferDispatchedBy")
  transfersReceived     OutletTransfer[]    @relation("TransferReceivedBy")
  transfersCancelled    OutletTransfer[]    @relation("TransferCancelledBy")
  expensesCreated       Expense[]           @relation("ExpenseCreatedBy")

  @@map("users")
}

// Opaque refresh tokens are stored only as SHA-256 hashes. Rotation replaces a
// session row with a new row in the same family; replaying a used token revokes
// the whole family.
model Session {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  familyId     String          @db.Uuid
  tokenHash    String          @unique
  csrfHash     String?
  platform     SessionPlatform
  deviceId     String?         @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?         @db.Uuid
  createdAt    DateTime        @default(now())
  lastUsedAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@unique([id, businessId])
  @@index([businessId, archivedAt])
  @@map("categories")
}

model MenuItem {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  categoryId  String    @db.Uuid
  name        String
  description String    @default("")
  revision    Int       @default(1)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  Category           @relation(fields: [categoryId, businessId], references: [id, businessId])
  variants  MenuVariant[]
  modifiers MenuItemModifier[]
  stationRoutes StationRoute[]

  @@index([businessId, archivedAt])
  @@index([categoryId])
  @@map("menu_items")
}

model MenuVariant {
  id          String      @id @default(uuid()) @db.Uuid
  menuItemId  String      @db.Uuid
  name        String
  priceMinor  BigInt
  active      Boolean     @default(true)
  stockPolicy StockPolicy @default(UNTRACKED)
  revision    Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  menuItem       MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  outletMenus    OutletMenu[]
  orderLines     OrderLine[]
  recipeVersions RecipeVersion[]
  stationJobs    StationJob[]

  @@index([menuItemId])
  @@map("menu_variants")
}

// Optional modifiers attach to a menu item and change the per-unit price. A
// modifier may also consume a stock item directly, so tracked ingredients are
// deducted on checkout and can be restored by an explicit refund restock.
model MenuItemModifier {
  id                  String   @id @default(uuid()) @db.Uuid
  businessId          String   @db.Uuid
  menuItemId          String   @db.Uuid
  name                String
  priceDeltaMinor     BigInt   @default(0)
  stockItemId         String?  @db.Uuid
  quantityPerSaleUnit Decimal? @db.Decimal(20, 6)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItem  MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItem StockItem? @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  outlet    Outlet?    @relation(fields: [outletId], references: [id])
  outletId  String?    @db.Uuid

  @@index([menuItemId, active])
  @@index([businessId])
  @@map("menu_item_modifiers")
}

model OutletMenu {
  outletId  String   @db.Uuid
  variantId String   @db.Uuid
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet  Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  variant MenuVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([outletId, variantId])
  @@index([variantId])
  @@map("outlet_menu")
}

// Stock quantities are fixed-point decimals(20,6). The base unit is immutable
// after the first movement because every historical delta is expressed in it.
model StockItem {
  id               String        @id @default(uuid()) @db.Uuid
  businessId       String        @db.Uuid
  name             String
  baseUnit         StockBaseUnit
  quantityScale    Int
  reorderThreshold Decimal       @db.Decimal(20, 6)
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  balances           StockBalance[]
  movements          StockMovement[]
  recipeLines        RecipeLine[]
  modifiers          MenuItemModifier[]
  purchaseOrderLines PurchaseOrderLine[]
  stockCountLines    StockCountLine[]
  stockWastes        StockWaste[]
  transferLines      OutletTransferLine[]

  @@unique([id, businessId])
  @@index([businessId, archivedAt])
  @@map("stock_items")
}

model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  outletId    String   @db.Uuid
  stockItemId String   @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(20, 6)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet    Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([outletId, stockItemId])
  @@index([stockItemId])
  @@map("stock_balances")
}

// Append-only ledger. The migration adds a trigger that rejects UPDATE and
// DELETE so a balance is always derivable from SUM(delta) per outlet+item.
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  outletId        String            @db.Uuid
  stockItemId     String            @db.Uuid
  delta           Decimal           @db.Decimal(20, 6)
  type            StockMovementType
  actorId         String            @db.Uuid
  reason          String
  sourceId        String            @db.Uuid
  sourceLineId    String?           @db.Uuid
  supplierId      String?           @db.Uuid
  purchaseOrderId String?           @db.Uuid
  transferId      String?           @db.Uuid
  stockCountId    String?           @db.Uuid
  stockWasteId    String?           @db.Uuid
  createdAt       DateTime          @default(now())

  outlet        Outlet          @relation(fields: [outletId], references: [id], onDelete: Restrict)
  stockItem     StockItem       @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  actor         User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  transfer      OutletTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)
  stockCount    StockCount?     @relation(fields: [stockCountId], references: [id], onDelete: Restrict)
  stockWaste    StockWaste?     @relation(fields: [stockWasteId], references: [id], onDelete: Restrict)

  @@index([outletId, stockItemId, createdAt])
  @@index([outletId, createdAt])
  @@index([stockItemId])
  @@index([supplierId, createdAt])
  @@map("stock_movements")
}

// Suppliers are business-wide records so a supplier can serve every outlet.
// Reference is optional but unique per business when present.
model Supplier {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  name       String
  reference  String?
  contact    String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  movements      StockMovement[]

  @@unique([businessId, reference])
  @@index([businessId, archivedAt])
  @@map("suppliers")
}

// A purchase order always receives into one outlet. Ordered quantities are
// stored in supplier units and in base units; the conversion is fixed at
// creation so later receipts cannot drift from the agreed pack size.
model PurchaseOrder {
  id          String             @id @default(uuid()) @db.Uuid
  businessId  String             @db.Uuid
  outletId    String             @db.Uuid
  supplierId  String             @db.Uuid
  reference   String
  state       PurchaseOrderState @default(OPEN)
  createdById String             @db.Uuid
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  closedAt    DateTime?

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet    Outlet              @relation(fields: [outletId], references: [id], onDelete: Restrict)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines     PurchaseOrderLine[]
  movements StockMovement[]

  @@unique([businessId, reference])
  @@index([businessId, outletId, state])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                       String   @id @default(uuid()) @db.Uuid
  purchaseOrderId          String   @db.Uuid
  stockItemId              String   @db.Uuid
  supplierUnit             String
  unitsPerSupplierUnit     Decimal  @db.Decimal(20, 6)
  orderedSupplierQuantity  Decimal  @db.Decimal(20, 6)
  receivedSupplierQuantity Decimal  @default(0) @db.Decimal(20, 6)
  orderedBaseQuantity      Decimal  @db.Decimal(20, 6)
  receivedBaseQuantity     Decimal  @default(0) @db.Decimal(20, 6)
  unitPrice                Decimal  @db.Decimal(20, 6)
  version                  Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([stockItemId])
  @@map("purchase_order_lines")
}

// Count lines snapshot the system quantity at the moment of counting. Only
// non-zero variances create ledger rows, so the count is never a silent
// overwrite of the append-only ledger.
model StockCount {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  outletId   String   @db.Uuid
  reference  String
  reason     String
  actorId    String   @db.Uuid
  createdAt  DateTime @default(now())

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet    Outlet           @relation(fields: [outletId], references: [id], onDelete: Restrict)
  actor     User             @relation("StockCountActor", fields: [actorId], references: [id], onDelete: Restrict)
  lines     StockCountLine[]
  movements StockMovement[]

  @@unique([businessId, reference])
  @@index([outletId, createdAt])
  @@map("stock_counts")
}

model StockCountLine {
  id              String  @id @default(uuid()) @db.Uuid
  stockCountId    String  @db.Uuid
  stockItemId     String  @db.Uuid
  systemQuantity  Decimal @db.Decimal(20, 6)
  countedQuantity Decimal @db.Decimal(20, 6)
  variance        Decimal @db.Decimal(20, 6)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  stockItem  StockItem  @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, stockItemId])
  @@index([stockItemId])
  @@map("stock_count_lines")
}

model StockWaste {
  id          String      @id @default(uuid()) @db.Uuid
  businessId  String      @db.Uuid
  outletId    String      @db.Uuid
  stockItemId String      @db.Uuid
  quantity    Decimal     @db.Decimal(20, 6)
  reason      WasteReason
  note        String?
  actorId     String      @db.Uuid
  createdAt   DateTime    @default(now())

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet    Outlet          @relation(fields: [outletId], references: [id], onDelete: Restrict)
  stockItem StockItem       @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  actor     User            @relation("StockWasteActor", fields: [actorId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@index([outletId, createdAt])
  @@map("stock_wastes")
}

// Transfers move stock between outlets in the same business. Dispatch removes
// from the source ledger; receive adds to the destination. The gap is the
// visible in-transit quantity and is intentionally absent from both balances.
model OutletTransfer {
  id                  String        @id @default(uuid()) @db.Uuid
  businessId          String        @db.Uuid
  sourceOutletId      String        @db.Uuid
  destinationOutletId String        @db.Uuid
  reference           String
  note                String?
  state               TransferState @default(DRAFT)
  createdById         String        @db.Uuid
  dispatchedById      String?       @db.Uuid
  receivedById        String?       @db.Uuid
  cancelledById       String?       @db.Uuid
  version             Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  dispatchedAt        DateTime?
  receivedAt          DateTime?
  cancelledAt         DateTime?

  business          Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceOutlet      Outlet               @relation("TransferSourceOutlet", fields: [sourceOutletId], references: [id], onDelete: Restrict)
  destinationOutlet Outlet               @relation("TransferDestinationOutlet", fields: [destinationOutletId], references: [id], onDelete: Restrict)
  createdBy         User                 @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  dispatchedBy      User?                @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: Restrict)
  receivedBy        User?                @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  cancelledBy       User?                @relation("TransferCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines             OutletTransferLine[]
  movements         StockMovement[]

  @@unique([businessId, reference])
  @@index([businessId, sourceOutletId, state])
  @@index([businessId, destinationOutletId, state])
  @@map("outlet_transfers")
}

model OutletTransferLine {
  id                 String   @id @default(uuid()) @db.Uuid
  transferId         String   @db.Uuid
  stockItemId        String   @db.Uuid
  dispatchedQuantity Decimal  @db.Decimal(20, 6)
  receivedQuantity   Decimal  @default(0) @db.Decimal(20, 6)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transfer  OutletTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  stockItem StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([transferId, stockItemId])
  @@index([stockItemId])
  @@map("outlet_transfer_lines")
}

// Durable idempotency mapping for stock writes. The unique (outletId, key)
// pair reserves the key inside the same transaction as the movement.
model StockIdempotency {
  id           String   @id @default(uuid()) @db.Uuid
  outletId     String   @db.Uuid
  key          String   @db.Uuid
  operation    String
  requestHash  String
  movementId   String?  @db.Uuid
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([outletId, key])
  @@index([createdAt])
  @@map("stock_idempotency")
}

// Recipes are append-only version snapshots. Publishing writes a new version row
// and its lines; historical versions and lines are never updated or deleted.
// A direct finished-goods link is represented as a one-line recipe.
model RecipeVersion {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  outletId    String   @db.Uuid
  variantId   String   @db.Uuid
  version     Int
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  variant  MenuVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lines    RecipeLine[]

  @@unique([variantId, outletId, version])
  @@index([businessId])
  @@index([outletId, variantId, version])
  @@map("recipe_versions")
}

model RecipeLine {
  id                  String   @id @default(uuid()) @db.Uuid
  recipeVersionId     String   @db.Uuid
  stockItemId         String   @db.Uuid
  quantityPerSaleUnit Decimal  @db.Decimal(20, 6)
  createdAt           DateTime @default(now())

  recipeVersion RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([recipeVersionId, stockItemId])
  @@index([stockItemId])
  @@map("recipe_lines")
}

// A physical table/seat inside one outlet. Orders reference a table only while
// they are dine-in drafts; the label is stable for receipts and audit text.
model DiningTable {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  outletId   String   @db.Uuid
  label      String
  seatCount  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([outletId, label])
  @@index([outletId, active])
  @@map("dining_tables")
}

// An order is an online draft owned by one cashier/device. The optional sale is
// unique per order so a different idempotency key cannot complete it twice.
// A split parent becomes SPLIT and never settles; each child is a normal draft
// with its own single sale, so stock and payment can never be duplicated.
model Order {
  id             String     @id @default(uuid()) @db.Uuid
  businessId     String     @db.Uuid
  outletId       String     @db.Uuid
  cashierId      String     @db.Uuid
  deviceId       String     @db.Uuid
  state          OrderState @default(DRAFT)
  version        Int        @default(1)
  idempotencyKey String     @db.Uuid
  requestHash    String
  tableId        String?    @db.Uuid
  splitGroupId   String?    @db.Uuid
  parentOrderId  String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  cashier  User         @relation("OrderCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  table    DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  parent   Order?       @relation("OrderSplit", fields: [parentOrderId], references: [id], onDelete: SetNull)
  children Order[]      @relation("OrderSplit")
  lines    OrderLine[]
  quotes   Quote[]
  sale     Sale?
  audits   OrderAudit[]
  splits   OrderSplit[] @relation("OrderSplitParent")
  stationJobs StationJob[]

  @@unique([outletId, deviceId, idempotencyKey])
  @@index([businessId, outletId, state])
  @@index([cashierId])
  @@index([tableId])
  @@index([parentOrderId])
  @@index([splitGroupId])
  @@map("orders")
}

// Append-only order transition log. A trigger rejects UPDATE and DELETE so the
// trail remains a faithful record of who moved which order and when.
model OrderAudit {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @db.Uuid
  outletId    String           @db.Uuid
  orderId     String           @db.Uuid
  actorId     String           @db.Uuid
  action      OrderAuditAction
  fromTableId String?          @db.Uuid
  toTableId   String?          @db.Uuid
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor    User     @relation("OrderAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([outletId, createdAt])
  @@map("order_audits")
}

// Durable idempotency mapping for one split request. The unique key reserves
// the split inside the same transaction that creates the child bills.
model OrderSplit {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @db.Uuid
  outletId       String   @db.Uuid
  parentOrderId  String   @db.Uuid
  actorId        String   @db.Uuid
  idempotencyKey String   @db.Uuid
  requestHash    String
  splitGroupId   String   @db.Uuid
  billCount      Int
  childOrderIds  Json
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  parent   Order    @relation("OrderSplitParent", fields: [parentOrderId], references: [id], onDelete: Restrict)
  actor    User     @relation("OrderSplitActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([outletId, idempotencyKey])
  @@index([parentOrderId])
  @@index([splitGroupId])
  @@map("order_splits")
}

model OrderLine {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  modifiers Json     @default("[]")
  createdAt DateTime @default(now())

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant MenuVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_lines")
}

// Quotes are immutable pricing snapshots with a 60-second validity. Lines are
// stored as a JSON snapshot so later catalog edits never rewrite them.
model Quote {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @db.Uuid
  outletId         String   @db.Uuid
  orderId          String   @db.Uuid
  orderVersion     Int
  settingsVersion  Int
  currency         String   @db.VarChar(3)
  currencyExponent Int
  taxBps           Int      @default(0)
  serviceBps       Int      @default(0)
  pricingMode      String   @default("EXCLUSIVE")
  rounding         String   @default("HALF_UP")
  expiresAt        DateTime
  customerEmail    String?
  subtotalMinor    BigInt
  discountMinor    BigInt   @default(0)
  serviceMinor     BigInt
  taxMinor         BigInt
  totalMinor       BigInt
  lines            Json
  promotions       Json     @default("[]")
  createdAt        DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([expiresAt])
  @@map("quotes")
}

// Sale and sale-line rows are the immutable financial snapshot. Catalog edits
// after completion must never change them.
model Sale {
  id               String    @id @default(uuid()) @db.Uuid
  businessId       String    @db.Uuid
  outletId         String    @db.Uuid
  orderId          String    @unique @db.Uuid
  cashierId        String    @db.Uuid
  deviceId         String    @db.Uuid
  reference        String
  state            SaleState @default(COMPLETED)
  currency         String    @db.VarChar(3)
  currencyExponent Int
  taxBps           Int       @default(0)
  serviceBps       Int       @default(0)
  pricingMode      String    @default("EXCLUSIVE")
  rounding         String    @default("HALF_UP")
  timezone         String
  subtotalMinor    BigInt
  discountMinor    BigInt    @default(0)
  serviceMinor     BigInt
  taxMinor         BigInt
  totalMinor       BigInt
  promotions       Json      @default("[]")
  completedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet           Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  cashier          User              @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines            SaleLine[]
  payment          PaymentRecord?
  onlinePayment    OnlinePayment?
  reversals        SaleReversal[]
  checkoutRequests CheckoutRequest[]
  printJobs        PrintJob[]
  stationJobs      StationJob[]

  @@unique([outletId, reference])
  @@index([businessId, outletId, completedAt])
  @@index([cashierId])
  @@map("sales")
}

model SaleLine {
  id                String @id @default(uuid()) @db.Uuid
  saleId            String @db.Uuid
  variantId         String @db.Uuid
  name              String
  variantName       String
  quantity          Int
  unitPriceMinor    BigInt
  lineSubtotalMinor BigInt
  modifiers         Json   @default("[]")
  recipeVersion     Int?

  sale    Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  refunds SaleRefundLine[]

  @@index([saleId])
  @@map("sale_lines")
}

// Immutable correction records linked to a completed sale. A full reversal is a
// single FULL row; partial refunds add PARTIAL rows that independently carry the
// money returned, the refunded sale lines and the explicit restock selection.
model SaleReversal {
  id                      String           @id @default(uuid()) @db.Uuid
  businessId              String           @db.Uuid
  outletId                String           @db.Uuid
  saleId                  String           @db.Uuid
  actorId                 String           @db.Uuid
  kind                    SaleReversalKind @default(FULL)
  reason                  String
  refundMinor             BigInt           @default(0)
  lines                   Json             @default("[]")
  restock                 Json
  externalRefundPerformed Boolean          @default(false)
  providerRefundRef       String?
  idempotencyKey          String           @db.Uuid
  requestHash             String
  createdAt               DateTime         @default(now())

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet      Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  actor       User             @relation("SaleReversalActor", fields: [actorId], references: [id], onDelete: Restrict)
  refundLines SaleRefundLine[]

  @@unique([outletId, idempotencyKey])
  @@index([saleId, createdAt])
  @@index([businessId, outletId, createdAt])
  @@map("sale_reversals")
}

model SaleRefundLine {
  id         String   @id @default(uuid()) @db.Uuid
  reversalId String   @db.Uuid
  saleLineId String   @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now())

  reversal SaleReversal @relation(fields: [reversalId], references: [id], onDelete: Cascade)
  saleLine SaleLine     @relation(fields: [saleLineId], references: [id], onDelete: Restrict)

  @@unique([reversalId, saleLineId])
  @@index([saleLineId])
  @@map("sale_refund_lines")
}

// Configurable promotions are evaluated entirely on the server. Eligibility is
// explicit: a nullable outlet scope, an optional date window, a minimum basket
// and optional variant/menu-item/customer allow lists stored as JSON.
model Promotion {
  id             String            @id @default(uuid()) @db.Uuid
  businessId     String            @db.Uuid
  outletId       String?           @db.Uuid
  name           String
  kind           PromotionKind
  percentageBps  Int?
  amountMinor    BigInt?
  minBasketMinor BigInt            @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean           @default(true)
  stacking       PromotionStacking @default(EXCLUSIVE)
  priority       Int               @default(0)
  eligibility    Json              @default("{}")
  revision       Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet?  @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([businessId, outletId, active])
  @@map("promotions")
}

// One threshold per sensitive action and outlet. A caller at or below the
// threshold may proceed; above it the caller must be an owner. Missing rules
// preserve the pre-existing owner-only refund behaviour.
model ApprovalRule {
  id             String         @id @default(uuid()) @db.Uuid
  businessId     String         @db.Uuid
  outletId       String         @db.Uuid
  action         ApprovalAction
  thresholdMinor BigInt         @default(0)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, action])
  @@map("approval_rules")
}

model PaymentRecord {
  id            String        @id @default(uuid()) @db.Uuid
  saleId        String        @unique @db.Uuid
  kind          PaymentKind
  status        PaymentStatus @default(RECORDED)
  amountMinor   BigInt
  tenderedMinor BigInt?
  changeMinor   BigInt?
  reference     String?
  createdAt     DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payment_records")
}

// Online payment intent for a completed sale. It is intentionally a separate
// record from PaymentRecord: a manual cash sale can never be reported as a
// provider payment, and the provider lifecycle remains auditable on its own.
model OnlinePayment {
  id                String          @id @default(uuid()) @db.Uuid
  businessId        String          @db.Uuid
  outletId          String          @db.Uuid
  saleId            String          @unique @db.Uuid
  provider          PaymentProvider
  providerRef       String?         @unique
  status            PaymentStatus   @default(PENDING)
  amountMinor       BigInt
  refundedMinor     BigInt          @default(0)
  currency          String          @db.VarChar(3)
  currencyExponent  Int
  qrPayload         String?
  attempt           Int             @default(1)
  providerCreatedAt DateTime?
  settledAt         DateTime?
  failedAt          DateTime?
  lastError         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet                @relation(fields: [outletId], references: [id], onDelete: Cascade)
  sale     Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  events   PaymentWebhookEvent[]

  @@index([businessId, outletId, status])
  @@index([provider, status])
  @@map("online_payments")
}

// Accepted provider webhook deliveries are stored by provider event id before
// any local transition. The unique key is the concurrency-safe dedupe winner.
model PaymentWebhookEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        PaymentProvider
  eventId         String
  eventType       String
  onlinePaymentId String?         @db.Uuid
  payload         Json
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?

  onlinePayment OnlinePayment? @relation(fields: [onlinePaymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([onlinePaymentId])
  @@map("payment_webhook_events")
}

// Deterministic in-repo sandbox provider ledger. It is never used when a real
// provider is configured and holds no production credentials.
model SandboxProviderPayment {
  id             String        @id @default(uuid()) @db.Uuid
  providerRef    String        @unique
  idempotencyKey String        @unique
  amountMinor    BigInt
  refundedMinor  BigInt        @default(0)
  currency       String        @db.VarChar(3)
  status         PaymentStatus @default(PENDING)
  refundKeys     Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("sandbox_provider_payments")
}

// Durable checkout recovery mapping. The request hash is reserved inside the
// same transaction as the sale and returned for replay/recovery.
model CheckoutRequest {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @db.Uuid
  outletId       String   @db.Uuid
  deviceId       String   @db.Uuid
  idempotencyKey String   @db.Uuid
  requestHash    String
  saleId         String?  @db.Uuid
  retainedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([outletId, deviceId, idempotencyKey])
  @@index([saleId])
  @@map("checkout_requests")
}

// Device-owned printer configuration. Hardware support is verified per
// model/transport; persisted enum values do not imply every transport ships.
model Printer {
  id                 String           @id @default(uuid()) @db.Uuid
  businessId         String           @db.Uuid
  outletId           String           @db.Uuid
  deviceId           String           @db.Uuid
  name               String
  model              String
  transport          PrinterTransport
  paperWidthMm       Int
  encoding           String
  connectionSettings Json             @default("{}")
  revision           Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet    Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  printJobs PrintJob[]
  stations  Station[]    @relation("StationPrinter")
  stationJobs StationJob[] @relation("StationJobPrinter")

  @@unique([outletId, deviceId, name])
  @@index([outletId, deviceId])
  @@map("printers")
}

// Diagnostic mirror of the local print queue. The device owns execution; the
// API record must never determine sale completion or paper delivery.
model PrintJob {
  id              String        @id @db.Uuid
  businessId      String        @db.Uuid
  outletId        String        @db.Uuid
  saleId          String        @db.Uuid
  deviceId        String        @db.Uuid
  printerConfigId String        @db.Uuid
  idempotencyKey  String        @db.Uuid
  state           PrintJobState @default(QUEUED)
  copy            Boolean       @default(false)
  attempts        Int           @default(0)
  lastError       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  printer  Printer  @relation(fields: [printerConfigId], references: [id], onDelete: Restrict)

  @@unique([outletId, deviceId, idempotencyKey])
  @@index([saleId])
  @@index([outletId, deviceId])
  @@map("print_jobs")
}

// Kitchen/bar station definitions are owner-managed per outlet. A station may
// point at a device printer configuration, but an unreachable station printer
// only blocks that station queue; it never blocks sales or another station.
model Station {
  id               String      @id @default(uuid()) @db.Uuid
  businessId       String      @db.Uuid
  outletId         String      @db.Uuid
  name             String
  kind             StationKind @default(KITCHEN)
  isDefault        Boolean     @default(false)
  printerConfigId  String?     @db.Uuid
  sortOrder        Int         @default(0)
  revision         Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  printer  Printer?       @relation("StationPrinter", fields: [printerConfigId], references: [id], onDelete: SetNull)
  routes   StationRoute[]
  jobs     StationJob[]

  @@unique([outletId, name])
  @@index([outletId, isDefault])
  @@map("stations")
}

// A menu item routes to exactly one station per outlet. Unrouted items fall
// back to the outlet default station (or the first station by sort order).
model StationRoute {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  outletId   String   @db.Uuid
  stationId  String   @db.Uuid
  menuItemId String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet    Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  station   Station    @relation(fields: [stationId], references: [id], onDelete: Cascade)
  menuItem  MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([outletId, menuItemId])
  @@index([stationId])
  @@map("station_routes")
}

// Station jobs are station-scoped print instructions. They mirror the receipt
// PrintJob states but are independent rows: retry, reprint, amendment and
// cancellation never update sale or stock records.
model StationJob {
  id              String          @id @db.Uuid
  businessId      String          @db.Uuid
  outletId        String          @db.Uuid
  stationId       String          @db.Uuid
  orderId         String          @db.Uuid
  saleId          String?         @db.Uuid
  variantId       String          @db.Uuid
  orderReference  String
  kind            StationJobKind  @default(ORIGINAL)
  state           PrintJobState   @default(QUEUED)
  copy            Boolean         @default(false)
  reprintOfId     String?         @db.Uuid
  itemName        String
  variantName     String
  quantity        Int
  modifiers       Json            @default("[]")
  attempts        Int             @default(0)
  lastError       String?
  printerConfigId String?         @db.Uuid
  idempotencyKey  String          @db.Uuid
  lineIndex       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  station  Station      @relation(fields: [stationId], references: [id], onDelete: Restrict)
  order    Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sale     Sale?        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  variant  MenuVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  printer  Printer?     @relation("StationJobPrinter", fields: [printerConfigId], references: [id], onDelete: SetNull)

  @@unique([outletId, idempotencyKey, lineIndex])
  @@index([stationId, state, createdAt])
  @@index([orderId])
  @@index([saleId])
  @@map("station_jobs")
}

// A cashier shift owns one drawer from opening float to counted close. Monetary
// values are integer minor units and the payout sum only changes through
// append-only ShiftCashMovement rows. Status plus version make close a
// compare-and-set so concurrent closes never double-count.
model Shift {
  id                String      @id @default(uuid()) @db.Uuid
  businessId        String      @db.Uuid
  outletId          String      @db.Uuid
  openedById        String      @db.Uuid
  closedById        String?     @db.Uuid
  status            ShiftStatus @default(OPEN)
  openingFloatMinor BigInt
  cashSalesMinor    BigInt      @default(0)
  paidInMinor       BigInt      @default(0)
  paidOutMinor      BigInt      @default(0)
  expectedCashMinor BigInt      @default(0)
  countedCashMinor  BigInt?
  discrepancyMinor  BigInt?
  closeNote         String?
  version           Int         @default(1)
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet    Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  openedBy  User                @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy  User?               @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  movements ShiftCashMovement[]

  @@index([outletId, status, openedAt])
  @@index([openedById, status])
  @@map("shifts")
}

// Append-only paid-in/paid-out ledger with an actor and reason on every row.
model ShiftCashMovement {
  id          String                @id @default(uuid()) @db.Uuid
  businessId  String                @db.Uuid
  outletId    String                @db.Uuid
  shiftId     String                @db.Uuid
  actorId     String                @db.Uuid
  kind        ShiftCashMovementKind
  amountMinor BigInt
  reason      String
  createdAt   DateTime              @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([shiftId, createdAt])
  @@index([outletId, createdAt])
  @@map("shift_cash_movements")
}

// Attendance is deliberately independent from Shift: clocking in or out never
// opens, closes or reconciles a drawer.
model AttendanceRecord {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @db.Uuid
  outletId     String    @db.Uuid
  userId       String    @db.Uuid
  clockInAt    DateTime  @default(now())
  clockOutAt   DateTime?
  clockInNote  String?
  clockOutNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([outletId, userId, clockInAt])
  @@index([outletId, clockInAt])
  @@map("attendance_records")
}

// Operational audit surface for shift and attendance actions. It mirrors the
// order_audits shape (businessId, outletId, actorId, action, metadata) but is
// not order-scoped, so cash accountability events remain searchable.
model OperationAudit {
  id         String               @id @default(uuid()) @db.Uuid
  businessId String               @db.Uuid
  outletId   String               @db.Uuid
  actorId    String               @db.Uuid
  action     OperationAuditAction
  entityType String
  entityId   String               @db.Uuid
  metadata   Json                 @default("{}")
  createdAt  DateTime             @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([outletId, createdAt, id])
  @@index([outletId, actorId, createdAt])
  @@index([outletId, action, createdAt])
  @@map("operation_audits")
}

// Bookkeeping is additive: an outlet opts into a costing method before profit
// or margin is reported. A missing setting means margin is unavailable instead
// of being silently valued at zero.
model BookkeepingSetting {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @db.Uuid
  outletId      String        @unique @db.Uuid
  costingMethod CostingMethod
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("bookkeeping_settings")
}

// Expense categories are explicitly defined before margin is presented. Names
// are unique per business so a report can label every manual expense.
model ExpenseCategory {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([businessId, name])
  @@index([businessId, active])
  @@map("expense_categories")
}

// Manual operating expense. incurredOn is an outlet-local calendar date stored
// as a date-only value; money stays in integer currency minor units.
model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  outletId    String   @db.Uuid
  categoryId  String   @db.Uuid
  amountMinor BigInt
  incurredOn  DateTime @db.Date
  note        String   @default("")
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet    Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category  ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([outletId, incurredOn])
  @@index([businessId, outletId, incurredOn])
  @@map("expenses")
}

// Explicit opt-in customer record. Consent is recorded with its source and
// timestamp at creation; a record can never be created without consent. The
// contact is normalised per outlet so the same person is one record per outlet.
model Customer {
  id               String                @id @default(uuid()) @db.Uuid
  businessId       String                @db.Uuid
  outletId         String                @db.Uuid
  name             String
  contactType      CustomerContactType
  contactNormalized String
  email            String?
  phone            String?
  consentAt        DateTime
  consentSource    CustomerConsentSource
  anonymizedAt     DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet        Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  channelOrders ChannelOrder[]

  @@unique([outletId, contactNormalized])
  @@index([businessId, outletId, createdAt])
  @@map("customers")
}

// Per-outlet retention configuration. Defaults are deliberate: customer
// records expire after 365 days and stored receipt artifacts after 90 days.
model CustomerRetentionPolicy {
  id                     String   @id @default(uuid()) @db.Uuid
  businessId             String   @db.Uuid
  outletId               String   @unique @db.Uuid
  customerRetentionDays  Int      @default(365)
  receiptRetentionDays   Int      @default(90)
  receiptLinkTtlMinutes  Int      @default(1440)
  version                Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("customer_retention_policies")
}

// Incoming order from one channel. The channel reference is the dedupe key:
// two deliveries with the same business, channel and reference produce exactly
// one local order. Lines are a price snapshot; catalog edits never rewrite them.
model ChannelOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  outletId           String              @db.Uuid
  channel            OrderChannel
  channelReference   String
  requestHash        String
  state              ChannelOrderState   @default(RECEIVED)
  paymentMode        ChannelPaymentMode  @default(CASH_ON_PICKUP)
  paymentStatus      ChannelPaymentStatus @default(UNPAID)
  currency           String              @db.VarChar(3)
  currencyExponent   Int
  subtotalMinor      BigInt
  serviceMinor       BigInt              @default(0)
  taxMinor           BigInt              @default(0)
  totalMinor         BigInt
  note               String              @default("")
  customerId         String?             @db.Uuid
  acceptedAt         DateTime?
  fulfilledAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet               @relation(fields: [outletId], references: [id], onDelete: Cascade)
  customer Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines    ChannelOrderLine[]
  payments ChannelOrderPayment[]
  events   ChannelOrderEvent[]

  @@unique([businessId, channel, channelReference])
  @@index([outletId, state, createdAt])
  @@index([outletId, channel, createdAt])
  @@index([customerId])
  @@map("channel_orders")
}

model ChannelOrderLine {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  variantId         String   @db.Uuid
  name              String
  variantName       String
  quantity          Int
  unitPriceMinor    BigInt
  lineSubtotalMinor BigInt
  recipeVersion     Int?
  createdAt         DateTime @default(now())

  order ChannelOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("channel_order_lines")
}

// One payment record per order. Cash is collected on pickup; a provider-paid
// order is a documented future mode and cannot create a second payment row.
model ChannelOrderPayment {
  id             String                @id @default(uuid()) @db.Uuid
  orderId        String                @unique @db.Uuid
  amountMinor    BigInt
  status         ChannelPaymentStatus  @default(PAID)
  method         ChannelPaymentMode
  reference      String?
  recordedById   String?               @db.Uuid
  createdAt      DateTime              @default(now())

  order ChannelOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("channel_order_payments")
}

model ChannelOrderEvent {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @db.Uuid
  fromState   ChannelOrderState
  toState     ChannelOrderState
  actorId     String?           @db.Uuid
  reason      String            @default("")
  createdAt   DateTime          @default(now())

  order ChannelOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("channel_order_events")
}

// Rendered receipt artifact. Only a SHA-256 token hash is stored; the one-time
// token is returned at creation. The public endpoint never enumerates customers
// and returns 404 for expired, purged or foreign tokens.
model DigitalReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @db.Uuid
  outletId       String   @db.Uuid
  saleId         String?  @db.Uuid
  channelOrderId String?  @db.Uuid
  customerId     String?  @db.Uuid
  receiptNumber  String
  tokenHash      String   @unique
  contentHtml    String
  contentText    String
  issuedAt       DateTime @default(now())
  expiresAt      DateTime
  purgedAt       DateTime?
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([businessId, receiptNumber])
  @@index([outletId, createdAt])
  @@index([outletId, expiresAt])
  @@index([saleId])
  @@map("digital_receipts")
}
