// Identity, authorization, business settings and catalog schema.
// Stock, recipes, sales, reports and printing domain models land in #7-#10.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  CASHIER
}

enum SessionPlatform {
  WEB
  MOBILE
}

enum StockPolicy {
  TRACKED
  UNTRACKED
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets    Outlet[]
  users      User[]
  categories Category[]
  menuItems  MenuItem[]

  @@map("businesses")
}

model Outlet {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @db.Uuid
  name             String
  timezone         String   @default("Asia/Jakarta")
  currency         String   @default("IDR")
  currencyExponent Int      @default(0)
  receiptAddress   String   @default("")
  receiptHeader    String   @default("")
  receiptFooter    String   @default("")
  taxBps           Int      @default(0)
  serviceBps       Int      @default(0)
  pricingMode      String   @default("EXCLUSIVE")
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       User[]
  outletMenus OutletMenu[]

  @@unique([businessId, name])
  @@map("outlets")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  outletId     String?  @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @default("")
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet   Outlet?   @relation(fields: [outletId], references: [id], onDelete: SetNull)
  sessions Session[]

  @@map("users")
}

// Opaque refresh tokens are stored only as SHA-256 hashes. Rotation replaces a
// session row with a new row in the same family; replaying a used token revokes
// the whole family.
model Session {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  familyId     String          @db.Uuid
  tokenHash    String          @unique
  csrfHash     String?
  platform     SessionPlatform
  deviceId     String?         @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?         @db.Uuid
  createdAt    DateTime        @default(now())
  lastUsedAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@unique([id, businessId])
  @@index([businessId, archivedAt])
  @@map("categories")
}

model MenuItem {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  categoryId  String    @db.Uuid
  name        String
  description String    @default("")
  revision    Int       @default(1)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId, businessId], references: [id, businessId])
  variants MenuVariant[]

  @@index([businessId, archivedAt])
  @@index([categoryId])
  @@map("menu_items")
}

model MenuVariant {
  id          String      @id @default(uuid()) @db.Uuid
  menuItemId  String      @db.Uuid
  name        String
  priceMinor  BigInt
  active      Boolean     @default(true)
  stockPolicy StockPolicy @default(UNTRACKED)
  revision    Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  menuItem    MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  outletMenus OutletMenu[]

  @@index([menuItemId])
  @@map("menu_variants")
}

model OutletMenu {
  outletId  String   @db.Uuid
  variantId String   @db.Uuid
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet  Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  variant MenuVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([outletId, variantId])
  @@index([variantId])
  @@map("outlet_menu")
}
