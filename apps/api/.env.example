# Local development only. Copy to apps/api/.env and adjust if needed.
# Matches docker-compose.yml defaults; never use these values outside local dev.
DATABASE_URL="postgresql://pos:pos_local_dev@localhost:5432/modern_pos?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000,http://localhost:3001"

# Auth (ticket #4). Local development defaults only.
JWT_SECRET="modern-pos-local-development-secret"
JWT_ISSUER="modern-pos-api"
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
SIGN_IN_MAX_ATTEMPTS=5
SIGN_IN_WINDOW_SECONDS=900
# Seed password for synthetic demo users; override locally, never in production.
SEED_PASSWORD="modern-pos-demo-password"
