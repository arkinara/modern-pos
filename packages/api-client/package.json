{
  "name": "@modern-pos/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed TypeScript client generated from the Modern POS OpenAPI contract.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check src/index.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
